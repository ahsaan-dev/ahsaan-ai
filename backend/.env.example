# --- LLM Provider ---
# Ahsaan AI is provider-agnostic. Anthropic is the default reasoning engine.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# --- Server ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# --- Privacy ---
# Hard switch. When true, the backend refuses to write any conversation
# content to disk, cache, or logs, no matter what other code paths do.
PRIVACY_MODE=true

# --- Optional: server-side voice providers ---
# Leave blank to rely on the browser's built-in Web Speech API (fully
# on-device for STT in most browsers, no audio ever leaves the client).
# Fill these in only if you want higher-quality cloud STT/TTS.
WHISPER_API_KEY=
TTS_PROVIDER_API_KEY=
